# Google Sheets Integration Setup
# Get these from your Google Cloud Console Service Account (JSON key file)
GOOGLE_CLIENT_EMAIL="your-service-account-email@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_LONG_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Get this from the Google Sheet URL: https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Optional: Tab name and columns range (defaults to Sheet1!A:G)
GOOGLE_SHEET_RANGE="Sheet1!A:G"
